// AEML, NTUST -- Wii phone-controller relay (Cloudflare Worker + Durable Object)
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aeml-wii-relay",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  "vars": {
    // pages allowed to use this relay (comma separated, * = any subdomain)
    "ALLOWED_ORIGINS": "https://*.concrete.tw,https://concrete.tw,https://chuntaoc.github.io,https://*.blogspot.com,https://www.blogger.com"
  }
}
