+#ifdef __EMSCRIPTEN__
+// ---------------------------------------------------------------------------
+// Browser Wii Remote input (AEML, NTUST). The page sends one snapshot per
+// input change through SetWiimoteState() (dolphin_web_discio.cpp); here it
+// is applied through Dolphin's own input-override hook, so buttons, D-pad,
+// accelerometer and Nunchuk go through the normal emulation path.
+// Layout must match dolphin_web_discio.cpp.
+struct DolphinWebWiimoteState
+{
+  std::uint32_t buttons;
+  std::int32_t extension;  // 0 = none, 1 = Nunchuk
+  float stick_x, stick_y;  // -1..1, +y = up
+  float ir_x, ir_y;        // -1..1, +y = up
+  std::int32_t ir_visible;
+  float accel_x, accel_y, accel_z;  // in g, Wii Remote axes
+};
+extern "C" int DolphinWeb_GetWiimoteState(int index, DolphinWebWiimoteState* out);
+
+namespace
+{
+enum : std::uint32_t
+{
+  WEB_UP = 1u << 0, WEB_DOWN = 1u << 1, WEB_LEFT = 1u << 2, WEB_RIGHT = 1u << 3,
+  WEB_A = 1u << 4, WEB_B = 1u << 5, WEB_ONE = 1u << 6, WEB_TWO = 1u << 7,
+  WEB_PLUS = 1u << 8, WEB_MINUS = 1u << 9, WEB_HOME = 1u << 10,
+  WEB_C = 1u << 11, WEB_Z = 1u << 12, WEB_SHAKE = 1u << 13,
+};
+
+std::optional<ControlState> WebBit(std::uint32_t buttons, std::uint32_t bit)
+{
+  return (buttons & bit) ? 1.0 : 0.0;
+}
+}  // namespace
+#endif
+
 void Wiimote::BuildDesiredWiimoteState(DesiredWiimoteState* target_state,
                                        SensorBarState sensor_bar_state)
 {
+#ifdef __EMSCRIPTEN__
+  DolphinWebWiimoteState web{};
+  const bool web_active = DolphinWeb_GetWiimoteState(m_index, &web) != 0;
+  if (web_active)
+  {
+    // Shake: oscillate the accelerometer, the way a real shake reads (~6 Hz, +-2.5 g).
+    static std::uint32_t s_shake_tick = 0;
+    Common::Vec3 accel(web.accel_x, web.accel_y, web.accel_z);
+    accel = accel * float(GRAVITY_ACCELERATION);
+    if (web.buttons & WEB_SHAKE)
+    {
+      const float phase = float(MathUtil::TAU) * 6.f * float(++s_shake_tick) / ::Wiimote::UPDATE_FREQ;
+      const float amount = 2.5f * float(GRAVITY_ACCELERATION) * std::sin(phase);
+      accel += Common::Vec3(amount, amount, amount);
+    }
+    else
+    {
+      s_shake_tick = 0;
+    }
+
+    SetInputOverrideFunction([web, accel](std::string_view group, std::string_view control,
+                                          ControlState) -> std::optional<ControlState> {
+      const std::uint32_t b = web.buttons;
+      if (group == BUTTONS_GROUP)
+      {
+        if (control == A_BUTTON) return WebBit(b, WEB_A);
+        if (control == B_BUTTON) return WebBit(b, WEB_B);
+        if (control == ONE_BUTTON) return WebBit(b, WEB_ONE);
+        if (control == TWO_BUTTON) return WebBit(b, WEB_TWO);
+        if (control == MINUS_BUTTON) return WebBit(b, WEB_MINUS);
+        if (control == PLUS_BUTTON) return WebBit(b, WEB_PLUS);
+        if (control == HOME_BUTTON) return WebBit(b, WEB_HOME);
+      }
+      else if (group == DPAD_GROUP)
+      {
+        if (control == DIRECTION_UP) return WebBit(b, WEB_UP);
+        if (control == DIRECTION_DOWN) return WebBit(b, WEB_DOWN);
+        if (control == DIRECTION_LEFT) return WebBit(b, WEB_LEFT);
+        if (control == DIRECTION_RIGHT) return WebBit(b, WEB_RIGHT);
+      }
+      else if (group == ACCELEROMETER_GROUP)
+      {
+        if (control == ControllerEmu::ReshapableInput::X_INPUT_OVERRIDE) return accel.x;
+        if (control == ControllerEmu::ReshapableInput::Y_INPUT_OVERRIDE) return accel.y;
+        if (control == ControllerEmu::ReshapableInput::Z_INPUT_OVERRIDE) return accel.z;
+      }
+      else if (group == IR_GROUP)
+      {
+        if (control == ControllerEmu::ReshapableInput::X_INPUT_OVERRIDE) return web.ir_x;
+        if (control == ControllerEmu::ReshapableInput::Y_INPUT_OVERRIDE) return web.ir_y;
+      }
+      return std::nullopt;
+    });
+
+    // Attach or detach the Nunchuk as the page asks.
+    const u32 wanted = web.extension == 1 ? u32(ExtensionNumber::NUNCHUK) : u32(ExtensionNumber::NONE);
+    if (m_attachments->GetSelectedAttachment() != wanted)
+      m_attachments->SetSelectedAttachment(wanted);
+
+    auto& nunchuk = m_attachments->GetAttachmentList()[u32(ExtensionNumber::NUNCHUK)];
+    nunchuk->SetInputOverrideFunction([web](std::string_view group, std::string_view control,
+                                            ControlState) -> std::optional<ControlState> {
+      if (group == Nunchuk::BUTTONS_GROUP)
+      {
+        if (control == Nunchuk::C_BUTTON) return WebBit(web.buttons, WEB_C);
+        if (control == Nunchuk::Z_BUTTON) return WebBit(web.buttons, WEB_Z);
+      }
+      else if (group == Nunchuk::STICK_GROUP)
+      {
+        if (control == ControllerEmu::ReshapableInput::X_INPUT_OVERRIDE) return web.stick_x;
+        if (control == ControllerEmu::ReshapableInput::Y_INPUT_OVERRIDE) return web.stick_y;
+      }
+      return std::nullopt;
+    });
+  }
+#endif
