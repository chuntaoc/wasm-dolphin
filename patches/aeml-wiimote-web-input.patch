+  for (int i = 0; i < 4; ++i)
+    if (bt->AccessWiimoteByIndex(i)->IsConnected())
+      links |= 1 << i;
+  DolphinWeb_SetLinks(links);
+
+  // Config::Get is cached, so checking every update is cheap; comparing with
+  // the setting (not a remembered value) also survives a new boot's config.
+  for (int i = 1; i < 4; ++i)
+  {
+    const int want = DolphinWeb_WiimoteWanted(i);
+    const auto& info = Config::GetInfoForWiimoteSource(i);
+    const WiimoteSource source = want ? WiimoteSource::Emulated : WiimoteSource::None;
+    if (Config::Get(info) != source)
+      Config::SetCurrent(info, source);
+  }
+}
